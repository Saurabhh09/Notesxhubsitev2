# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="NotesXhub"

# Signs the session cookie and the short-lived download tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
DOWNLOAD_TOKEN_SECRET=""

# ── Private file storage ────────────────────────────────────────────────────
# Root for paid PDFs. MUST stay outside ./public so nothing is served statically.
PRIVATE_STORAGE_DIR="./storage"

# ── Razorpay ────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys while developing.
# Only the key id is exposed to the browser; the secret stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks. Subscribe to payment.captured + payment.failed.
RAZORPAY_WEBHOOK_SECRET=""

# ── Order notification email (SMTP) ─────────────────────────────────────────
# Gmail: create an App Password (Google Account → Security → App passwords).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="notesxhub09@gmail.com"
SMTP_PASS=""
MAIL_FROM="NotesXhub <notesxhub09@gmail.com>"
OWNER_EMAIL="notesxhub09@gmail.com"

# ── Contact ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="9711483875"
NEXT_PUBLIC_SUPPORT_EMAIL="notesxhub09@gmail.com"

# ── Seed admin (used once by scripts/seed.mjs) ──────────────────────────────
ADMIN_EMAIL="notesxhub09@gmail.com"
ADMIN_NAME="NotesXhub Admin"
ADMIN_PASSWORD=""

# Folder scanned by scripts/ingest-pdfs.mjs
SOURCE_PDF_DIR=""
